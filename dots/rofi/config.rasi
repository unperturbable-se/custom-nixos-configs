/* Minimal frosted rofi theme (Catppuccin Mocha accents) + custom apps */

configuration {
  /* "combi" merges desktop apps and your custom apps into one list */
  modi:                 "combi,run,custom:/home/raed/.config/rofi/custom.sh";
  combi-modes:          "drun,custom";
  combi-display-format: "{text}";

  show-icons:           true;
  icon-theme:           "Papirus-Dark";
  drun-display-format:  "{name}";
  terminal:             "kitty";
  font:                 "JetBrainsMono Nerd Font 11";
  matching:             "fuzzy";
  sidebar-mode:         false;
  hide-scrollbar:       true;
}

* {
  base:    #1e1e2e;
  text:    #cdd6f4;
  subtext: #7f849c;
  accent:  #cba6f7;

  background-color: transparent;
  text-color:       @text;
  margin:           0px;
  padding:          0px;
  spacing:          0px;
}

window {
  width:            560px;
  background-color: #1e1e2ed0;
  border:           1px;
  border-color:     #cba6f740;
  border-radius:    18px;
  padding:          20px;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  14px;
}

inputbar {
  padding:      4px 8px 14px 8px;
  border:       0px 0px 1px 0px;
  border-color: #cdd6f41a;
  children:     [ entry ];
}

entry {
  font:              "JetBrainsMono Nerd Font 13";
  placeholder:       "Search";
  placeholder-color: @subtext;
  cursor-color:      @accent;
}

listview {
  lines:        7;
  columns:      1;
  fixed-height: false;
  dynamic:      true;
  scrollbar:    false;
  spacing:      4px;
}

element {
  padding:       10px 14px;
  border-radius: 12px;
  spacing:       14px;
  orientation:   horizontal;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @text;
}

element selected.normal {
  background-color: #cba6f726;
  text-color:       @accent;
}

element-icon {
  size:           26px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
